# Application Settings
APP_NAME=MAILSENTINEL
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173

# Database Connection (PostgreSQL with SQLAlchemy 2.x and Psycopg 3 driver)
# Placeholder format:
#   postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+psycopg://your_db_user:your_db_password@localhost:5432/mailsentinel_db


# Database Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=5
DB_ECHO=false

# External Threat Intelligence Settings
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
THREAT_INTEL_TIMEOUT_SECONDS=10
THREAT_INTEL_CACHE_HOURS=24



